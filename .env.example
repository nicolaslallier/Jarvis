# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Must exactly match JARVIS_DB_PASSWORD set in the Infra repo's .env
# (/Users/nicolaslallier/Claude/Infra/.env) for the `jarvis` app database.
JARVIS_DB_PASSWORD=change-me

# Local postgres (if running the db service from main)
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskmaster

# API configuration
API_PORT=8000
CORS_ORIGINS=*
APP_ENV=development

# LM Studio server (Local Server tab in LM Studio, OpenAI-compatible API).
# The backend runs inside Docker, so `127.0.0.1` would point at the
# container itself, not the host machine running LM Studio — use
# host.docker.internal instead. If running the backend un-dockerized
# (e.g. `uvicorn app.main:app` directly on the host), set this back to
# http://127.0.0.1:1234.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat

# Observability (Infra LGTM stack). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty
# to disable tracing (e.g. local pytest). Compose defaults to http://alloy:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=jarvis-api

# MinIO (S3-compatible object storage) from the Infra repo's shared stack.
# There's no per-app MinIO provisioning yet (unlike Postgres's per-app
# DB/role), so MINIO_ACCESS_KEY/MINIO_SECRET_KEY must exactly match
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD set in the Infra repo's .env
# (/Users/nicolaslallier/Claude/Infra/.env) for now. MINIO_ENDPOINT is the
# internal Docker network address the backend connects to.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=jarvis

# RabbitMQ from the Infra repo's shared stack. Same situation as MinIO
# above — there's no per-app RabbitMQ provisioning yet, so
# RABBITMQ_USER/RABBITMQ_PASSWORD must exactly match
# RABBITMQ_DEFAULT_USER/RABBITMQ_DEFAULT_PASS set in the Infra repo's .env
# (/Users/nicolaslallier/Claude/Infra/.env). Used by both api (to publish
# ingest requests) and batch (to consume them and publish completions) —
# docker-compose.yml composes RABBITMQ_URL from these two values.
RABBITMQ_USER=infra
RABBITMQ_PASSWORD=change-me

# Batch worker (batch/) — internal APScheduler-driven container, no HTTP
# API. Reuses DATABASE_URL/MINIO_*/APP_ENV/OTEL_EXPORTER_OTLP_ENDPOINT above.
# Separate from OTEL_SERVICE_NAME (used by the api service) since both
# services read this same .env file/compose environment block.
BATCH_OTEL_SERVICE_NAME=jarvis-batch

# How often (minutes) the batch container's internal scheduler runs its
# registered jobs (heartbeat, and ingest_trigger below).
BATCH_JOB_INTERVAL_MINUTES=15

# ntfy.sh (https://ntfy.sh) push notifications — batch's reminders job
# (batch/app/jobs/reminders.py) posts a summary of overdue tasks and
# tomorrow's appointments here. Leave NTFY_TOPIC empty to disable reminders
# entirely (ntfy is optional, not a hard dependency). ntfy.sh topics are
# public and unauthenticated by default — anyone who knows/guesses the topic
# name can read your notifications, so pick a long, hard-to-guess topic
# name, or self-host ntfy (set NTFY_URL to your own instance) for privacy.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# How often (minutes) the reminders job runs. Deliberately less frequent
# than BATCH_JOB_INTERVAL_MINUTES above to avoid notification spam.
REMINDER_JOB_INTERVAL_MINUTES=30

# TIMEZONE (declared further below, alongside the chat endpoint's use of it)
# is also read by batch's reminders job to compute "tomorrow" (for
# appointment reminders) in local time instead of UTC — same IANA timezone
# name, same reasoning, no separate BATCH_TIMEZONE needed since both
# services share this .env file.

# Ingestion (ingest/) — normally-stopped container that batch's
# ingest_trigger job starts (via the Docker socket) whenever there are
# unprocessed files. See "Prerequisite before running ingestion" in
# CLAUDE.md for the pgvector extension this needs in Infra's Postgres.
INGEST_CONTAINER_NAME=jarvis-ingest
INGEST_OTEL_SERVICE_NAME=jarvis-ingest

# LM Studio embedding model — SEPARATE from LMSTUDIO_MODEL above, which is
# a chat model. Must match a model actually loaded in LM Studio capable of
# producing embeddings, and its output dimension must match
# EMBEDDING_DIMENSIONS in shared/jarvis_shared/models.py (768 by default) —
# changing models later needs a migration and a full re-embed. Read by both
# ingest (to embed file chunks) and api (to embed each chat message for RAG
# retrieval, see backend/app/rag.py) — they must stay pointed at the same
# model, since a query embedded differently than the chunks isn't comparable.
EMBEDDING_LMSTUDIO_BASE_URL=http://host.docker.internal:1234
EMBEDDING_LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5

# How many file_chunks the chat endpoint retrieves as context per message.
RAG_TOP_K=4

# How many memories (facts the secretary has learned about the user across
# past chat exchanges, see backend/app/memory.py) the chat endpoint
# retrieves as context per message. Extraction of new memories reuses
# LMSTUDIO_MODEL/LMSTUDIO_BASE_URL above (the chat model) and
# EMBEDDING_LMSTUDIO_MODEL/EMBEDDING_LMSTUDIO_BASE_URL (to embed the
# extracted facts) — no separate model config needed.
MEMORY_TOP_K=6

# IANA timezone name the chat endpoint uses to ground the model's "current
# date/time" context in local time instead of UTC (see app/routers/chat.py's
# _build_datetime_context) — otherwise relative expressions like "tomorrow"
# or "tonight" can resolve to the wrong calendar day. Also read by batch's
# reminders job (see the NTFY_* section above) for the same reason.
TIMEZONE=America/Toronto

# How many of the most recent chat messages are sent to the model per turn.
# The full history is always persisted regardless — this only bounds what's
# sent to LM Studio, so a long-running session doesn't eventually overflow
# the local model's context window. 0 disables truncation.
CHAT_HISTORY_MAX_MESSAGES=40

# LM Studio vision-capable chat model — again SEPARATE from the models
# above. Used to describe an image's content in words so that description
# (not the pixels) is what gets chunked and embedded, making image content
# findable via text search. Must be a model loaded in LM Studio that
# accepts image input (e.g. a Qwen2-VL or LLaVA variant).
VISION_LMSTUDIO_BASE_URL=http://host.docker.internal:1234
VISION_LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b

# Naive fixed-size character chunking for ingestion (see ingest/app/chunking.py).
INGEST_CHUNK_SIZE_CHARS=1000
INGEST_CHUNK_OVERLAP_CHARS=150

# Frontend configuration
# The frontend container has no published host port — it's reached via the
# Infra repo's shared NGINX at jarvis.famillelallier.net (see
# nginx/conf.d/jarvis.conf there), not localhost.
# Browser-facing URL for the backend; baked into the frontend's static build
# at container build time, so it must be the backend's published host port,
# not an internal Docker network name.
VITE_API_URL=http://localhost:8000
