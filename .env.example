# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Must exactly match JARVIS_DB_PASSWORD set in the Infra repo's .env
# (/Users/nicolaslallier/Claude/Infra/.env) for the `jarvis` app database.
JARVIS_DB_PASSWORD=change-me

# Local postgres (if running the db service from main)
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskmaster

# API configuration
API_PORT=8000
CORS_ORIGINS=*
APP_ENV=development

# Frontend configuration
FRONTEND_PORT=5173
# Browser-facing URL for the backend; baked into the frontend's static build
# at container build time, so it must be the backend's published host port,
# not an internal Docker network name.
VITE_API_URL=http://localhost:8000
